# Template: /projects/job/.gitconfig-job  (copie para o path do includeIf)
# Identidade e credencial ISOLADAS do contexto "trabalho".
[user]
    name  = Nome No Trabalho
    email = voce@empresa.com
    signingkey = ~/.ssh/id_ed25519_trabalho.pub
[gpg "ssh"]
    allowedSignersFile = ~/.ssh/allowed_signers
[credential]
    helper = cache --timeout=3600      # token do trabalho, isolado do pessoal
[url "git@github.com-trabalho:"]
    insteadOf = https://github.com/    # push/pull roteia para a conta do trabalho

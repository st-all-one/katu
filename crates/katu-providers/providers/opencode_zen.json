    {"name": "deepseek-v4-flash", "context_limit": 1000000, "prompt_cache": true},
    {"name": "deepseek-v4.1-flash", "context_limit": 1000000, "prompt_cache": true},
    {"name": "deepseek-v4-flash-free", "context_limit": 1000000},
